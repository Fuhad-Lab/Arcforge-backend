# Arcforge Daytona Service

# Required: your Daytona API key
DAYTONA_API_KEY=dtn_your_key_here

# Optional service config
DEBUG=false
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000

# Sandbox defaults
DEFAULT_SANDBOX_LANGUAGE=python
DEFAULT_SANDBOX_IMAGE=daytonaio/workspace-python:latest
DEFAULT_CPU=2.0
DEFAULT_MEMORY=4Gi
DEFAULT_DISK=10Gi
SANDBOX_IDLE_TIMEOUT_SECONDS=1800
